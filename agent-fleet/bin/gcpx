#!/usr/bin/env python3
"""Remote workspaces on configured GCP workers; model execution stays local."""
import argparse
from contextlib import ExitStack
import fcntl
import json
import math
import os
from pathlib import Path, PurePosixPath
import re
import shlex
import subprocess
import sys
import time
import uuid
from urllib.parse import urlsplit

ROOT = Path(os.environ.get('GCPX_STATE_DIR', Path.home() / '.agent-fleet/gcpx'))
NAME = re.compile(r'^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$')

def run(argv, **kw):
    return subprocess.run(argv, check=True, **kw)

def name(value):
    if not NAME.fullmatch(value) or value in ('.', '..'):
        raise ValueError('invalid name')
    return value

def config(path):
    data = json.loads(Path(path).read_text())
    if not isinstance(data.get('workers'), dict) or not isinstance(data.get('repos'), dict):
        raise ValueError('config requires workers and repos maps')
    return data

def remote_path(root, *parts):
    p = PurePosixPath(root)
    if not p.is_absolute() or str(p) != root or str(p) == '/' or '..' in p.parts:
        raise ValueError('worker root must be a normalized absolute path')
    return str(p.joinpath(*map(name, parts)))

def ssh_args(worker):
    cfg = Path(worker['ssh_config']).expanduser()
    if not cfg.is_absolute(): raise ValueError('ssh_config must be absolute')
    return ['/usr/bin/ssh', '-F', str(cfg), '-o', 'BatchMode=yes', name(worker['host'])]

def ssh(worker, command, capture=False, tty=False):
    args = ssh_args(worker)
    if tty: args.insert(-1, '-t')
    return run([*args, command], text=True, capture_output=capture)

def cmdstr(args): return shlex.join([str(x) for x in args])

def mutagen_env(worker_id, worker):
    # Each worker gets its own daemon because the SSH wrapper is inherited by
    # the daemon process and must not be shared across different configs.
    base = ROOT / 'mutagen' / name(worker_id)
    bindir = base / 'bin'
    bindir.mkdir(parents=True, mode=0o700, exist_ok=True)
    ssh_config = Path(worker['ssh_config']).expanduser()
    if not ssh_config.is_absolute(): raise ValueError('ssh_config must be absolute')
    for executable in ('ssh', 'scp'):
        wrapper = bindir / executable
        content = '#!/bin/sh\nexec /usr/bin/' + executable + ' -F ' + shlex.quote(str(ssh_config)) + ' "$@"\n'
        if not wrapper.exists() or wrapper.read_text() != content:
            wrapper.write_text(content); wrapper.chmod(0o700)
    return {**os.environ, 'MUTAGEN_DATA_DIRECTORY': str(base / 'data'),
            'MUTAGEN_SSH_PATH': str(bindir), 'MUTAGEN_SSH_CONNECT_TIMEOUT': '60'}

def mutagen(worker_id, worker, *args):
    return run(['mutagen', *args], env=mutagen_env(worker_id, worker), stdout=sys.stderr)

def load_state():
    p = ROOT / 'workspaces.json'
    return json.loads(p.read_text()) if p.exists() else {}

def save_state(state):
    tmp = ROOT / ('workspaces.' + uuid.uuid4().hex + '.tmp')
    tmp.write_text(json.dumps(state, indent=2) + '\n')
    os.chmod(tmp, 0o600)
    os.replace(tmp, ROOT / 'workspaces.json')

def log_event(action, **fields):
    entry = {'time': time.time(), 'action': action, **fields}
    fd = os.open(ROOT / 'events.log', os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    try: os.write(fd, (json.dumps(entry, ensure_ascii=False) + '\n').encode())
    finally: os.close(fd)

def load_idle():
    p = ROOT / 'worker-idle.json'
    return json.loads(p.read_text()) if p.exists() else {}

def save_idle(state):
    tmp = ROOT / ('idle.' + uuid.uuid4().hex + '.tmp')
    tmp.write_text(json.dumps(state, indent=2) + '\n')
    os.chmod(tmp, 0o600)
    os.replace(tmp, ROOT / 'worker-idle.json')

def mark_worker_busy(worker_id):
    idle = load_idle()
    if worker_id in idle:
        del idle[worker_id]
        save_idle(idle)

def entry(state, config_data, ws):
    name(ws)
    if ws not in state: raise ValueError('unknown workspace')
    item = state[ws]
    if item.get('status') == 'creating':
        raise ValueError('workspace creation is incomplete; inspect remote state')
    worker = config_data['workers'][item['worker']]
    expected = remote_path(worker['root'], 'workspaces', ws)
    if item['path'] != expected: raise ValueError('workspace path does not match configured root')
    return item, worker

def choose_worker(config_data, state, repo, requested=None):
    spec = config_data['repos'][repo]
    candidates = spec.get('workers', [spec.get('worker')])
    if (not isinstance(candidates, list) or not candidates or
            any(not isinstance(candidate, str) for candidate in candidates) or
            len(set(candidates)) != len(candidates)):
        raise ValueError('repository requires a nonempty worker list')
    if requested is not None:
        if requested not in candidates: raise ValueError('worker is not configured for repository')
        candidates = [requested]
    choices = []
    for worker_id in candidates:
        name(worker_id)
        worker = config_data['workers'][worker_id]
        cap = worker.get('capacity', int(os.environ.get('GCPX_WORKER_CAPACITY', '16')))
        if isinstance(cap, bool) or not isinstance(cap, int) or cap < 1:
            raise ValueError('worker capacity must be a positive integer')
        used = sum(1 for item in state.values() if item.get('worker') == worker_id)
        if used < cap: choices.append((used / cap, used, worker_id))
    if not choices: raise ValueError('GCP worker capacity exhausted; no local fallback')
    worker_id = min(choices)[2]
    return worker_id, config_data['workers'][worker_id]

def ensure_worker_ready(worker):
    if not worker.get('create'): return
    try: ssh(worker, 'test -f /var/lib/gcpx/bootstrap-ready', capture=True)
    except (OSError, subprocess.CalledProcessError):
        raise ValueError('worker bootstrap is not ready; no local fallback')

def allocate_worker(config_data, state, repo, requested=None):
    """Prefer available running workers; start configured stopped workers if needed."""
    pending = dict(state)
    stopped = []
    missing = []
    starting = False
    while True:
        try:
            worker_id, worker = choose_worker(config_data, pending, repo, requested)
        except ValueError as error:
            if 'capacity exhausted' not in str(error): raise
            break
        # Validate paths and transport before any action that may incur cost.
        remote_path(worker['root'], 'workspaces', 'validation')
        ssh_args(worker)
        if worker.get('managed') is not True:
            return worker_id, worker
        if any(not isinstance(worker.get(key), str) or not NAME.fullmatch(worker[key]) for key in ('project', 'zone', 'instance', 'pool')):
            raise ValueError('managed worker requires valid project, zone, instance and pool')
        if worker.get('create'):
            query = ['gcloud', 'compute', 'instances', 'list', '--project', worker['project'], '--zones', worker['zone'], '--filter', 'name=' + worker['instance'], '--format=json']
            instances = json.loads(run(query, text=True, capture_output=True).stdout)
            instances = [item for item in instances if item.get('name') == worker['instance']]
            if len(instances) > 1: raise ValueError('ambiguous worker instance identity')
            if not instances:
                missing.append((worker_id, worker))
                instance = None
            else: instance = instances[0]
        else:
            describe = ['gcloud', 'compute', 'instances', 'describe', worker['instance'], '--project', worker['project'], '--zone', worker['zone'], '--format=json']
            instance = json.loads(run(describe, text=True, capture_output=True).stdout)
        if instance is None:
            cap = worker.get('capacity', int(os.environ.get('GCPX_WORKER_CAPACITY', '16')))
            for index in range(cap): pending[f'\0{worker_id}:{index}'] = {'worker': worker_id}
            continue
        labels = instance.get('labels') or {}
        if instance.get('name') != worker['instance'] or labels.get('gcpx-managed') != 'true' or labels.get('gcpx-pool') != worker['pool']:
            raise ValueError('worker ownership labels do not match')
        if instance.get('status') == 'RUNNING':
            try:
                ensure_worker_ready(worker)
                return worker_id, worker
            except ValueError:
                starting = True
        elif instance.get('status') in ('PROVISIONING', 'STAGING'):
            starting = True
        if instance.get('status') == 'TERMINATED': stopped.append((worker_id, worker))
        # Temporarily mark the candidate full while examining the rest. These
        # synthetic records never enter persistent state.
        cap = worker.get('capacity', int(os.environ.get('GCPX_WORKER_CAPACITY', '16')))
        for index in range(cap): pending[f'\0{worker_id}:{index}'] = {'worker': worker_id}
    if starting:
        raise ValueError('worker bootstrap is not ready; no local fallback')
    if stopped:
        worker_id, worker = stopped[0]
        start_worker(config_data, worker_id, time.time())
        mark_worker_busy(worker_id)
        log_event('up', worker=worker_id, status='RUNNING')
        return worker_id, worker
    if missing:
        worker_id, worker = missing[0]
        create_worker(config_data, worker_id, time.time())
        mark_worker_busy(worker_id)
        log_event('create', worker=worker_id, status='RUNNING')
        return worker_id, worker
    raise ValueError('GCP worker capacity exhausted or unavailable; no local fallback')

def workspace_lease(ws, exclusive=False):
    directory = ROOT / 'leases'
    directory.mkdir(mode=0o700, exist_ok=True)
    lease = (directory / name(ws)).open('a')
    try:
        fcntl.flock(lease, (fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH) | fcntl.LOCK_NB)
    except BlockingIOError:
        lease.close()
        raise ValueError('workspace is in use')
    return lease

def stop_worker(config_data, state, worker_id):
    name(worker_id)
    worker = config_data['workers'][worker_id]
    if worker.get('managed') is not True:
        raise ValueError('refusing to stop a worker not explicitly managed by gcpx')
    for key in ('project', 'zone', 'instance', 'pool'):
        if not isinstance(worker.get(key), str) or not NAME.fullmatch(worker[key]):
            raise ValueError('managed worker requires valid project, zone, instance and pool')
    identity = ['--project', worker['project'], '--zone', worker['zone']]
    with ExitStack() as leases:
        for ws_id, item in state.items():
            if item.get('worker') == worker_id:
                if item.get('status') == 'creating':
                    raise ValueError('worker has an incomplete workspace creation')
                leases.enter_context(workspace_lease(ws_id, exclusive=True))
        describe = ['gcloud', 'compute', 'instances', 'describe', worker['instance'], *identity, '--format=json']
        instance = json.loads(run(describe, text=True, capture_output=True).stdout)
        labels = instance.get('labels') or {}
        if instance.get('name') != worker['instance'] or labels.get('gcpx-managed') != 'true' or labels.get('gcpx-pool') != worker['pool']:
            raise ValueError('worker ownership labels do not match; refusing stop')
        if instance.get('status') == 'TERMINATED': return {'worker': worker_id, 'status': 'TERMINATED'}
        if instance.get('status') != 'RUNNING': raise ValueError('worker is not in a stable running state')
        run(['gcloud', 'compute', 'instances', 'stop', worker['instance'], *identity, '--quiet'], stdout=sys.stderr)
        status = json.loads(run(describe, text=True, capture_output=True).stdout).get('status')
        if status != 'TERMINATED': raise ValueError('worker stop was not confirmed')
        return {'worker': worker_id, 'status': status}

def check_credit(worker, now):
    proof_path = worker.get('credit_evidence')
    if not proof_path:
        estimate = worker.get('monthly_estimate_usd')
        try: cap = float(os.environ['FLEET_GCP_MONTHLY_CAP'])
        except (KeyError, ValueError): raise ValueError('FLEET_GCP_MONTHLY_CAP must be explicitly configured')
        if isinstance(estimate, bool) or not isinstance(estimate, (int, float)) or not math.isfinite(estimate) or estimate <= 0 or not math.isfinite(cap) or cap <= 0 or estimate > cap:
            raise ValueError('monthly estimate must be positive and within FLEET_GCP_MONTHLY_CAP')
        billing = json.loads(run(['gcloud', 'billing', 'projects', 'describe', worker['project'], '--format=json'], text=True, capture_output=True).stdout)
        account = billing.get('billingAccountName', '')
        if billing.get('billingEnabled') is not True or not account.startswith('billingAccounts/'):
            raise ValueError('project billing account unavailable')
        project = json.loads(run(['gcloud', 'projects', 'describe', worker['project'], '--format=json'], text=True, capture_output=True).stdout)
        number = str(project.get('projectNumber', ''))
        if not number.isdigit(): raise ValueError('project number unavailable')
        budgets = json.loads(run(['gcloud', 'billing', 'budgets', 'list', '--billing-account', account.split('/')[-1], '--format=json'], text=True, capture_output=True).stdout)
        def covers(b):
            f = b.get('budgetFilter') or {}
            projects = f.get('projects') or []
            amount = (b.get('amount') or {}).get('specifiedAmount') or {}
            try: budget = float(amount.get('units', 0)) + float(amount.get('nanos', 0)) / 1e9
            except (ValueError, TypeError): return False
            thresholds = b.get('thresholdRules') or []
            alert = any(isinstance(t, dict) and isinstance(t.get('thresholdPercent'), (int, float)) and not isinstance(t.get('thresholdPercent'), bool) and 0 < t['thresholdPercent'] and budget * t['thresholdPercent'] <= cap and t.get('spendBasis', 'CURRENT_SPEND') == 'CURRENT_SPEND' for t in thresholds)
            return (amount.get('currencyCode') == 'USD' and math.isfinite(budget) and budget > 0 and alert and
                    (not projects or 'projects/' + number in projects) and
                    f.get('calendarPeriod', 'MONTH') == 'MONTH' and
                    not any(f.get(k) for k in ('labels', 'services', 'subaccounts', 'resourceAncestors', 'creditTypes')) and
                    bool(b.get('thresholdRules')) and
                    not (b.get('notificationsRule') or {}).get('disableDefaultIamRecipients', False))
        if not any(covers(b) for b in budgets): raise ValueError('no existing Budget alert covers this project; create none automatically')
        print(f'gcpx: estimated monthly USD {estimate}, cap USD {cap}; credit balance unknown, existing Budget alert found', file=sys.stderr)
        return
    if not isinstance(proof_path, str) or not Path(proof_path).is_absolute():
        raise ValueError('credit evidence path must be absolute')
    proof = json.loads(Path(proof_path).read_text())
    observed, remaining, estimate = (proof.get(k) for k in ('observed_at', 'remaining_usd', 'monthly_estimate_usd'))
    if (any(isinstance(v, bool) or not isinstance(v, (float, int)) or not math.isfinite(v) for v in (observed, remaining, estimate))
            or not 0 <= now - observed <= 3600 or estimate <= 0 or remaining < estimate or proof.get('compute_scope_verified') is not True):
        raise ValueError('credit evidence must be current, cover Compute and cover the monthly estimate')
    billing = json.loads(run(['gcloud', 'billing', 'projects', 'describe', worker['project'], '--format=json'], text=True, capture_output=True).stdout)
    if billing.get('billingEnabled') is not True or billing.get('billingAccountName') != proof.get('billing_account'):
        raise ValueError('credit evidence does not match the project billing account')

def credit_summary(config_data, now):
    paths = {worker.get('credit_evidence') for worker in config_data['workers'].values() if worker.get('credit_evidence')}
    if len(paths) != 1: return None
    path = paths.pop()
    if not isinstance(path, str) or not Path(path).is_absolute(): return None
    try: proof = json.loads(Path(path).read_text())
    except (OSError, ValueError): return None
    observed, remaining, estimate = (proof.get(k) for k in ('observed_at', 'remaining_usd', 'monthly_estimate_usd'))
    if any(isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v) for v in (observed, remaining, estimate)):
        return None
    return {'remaining_usd': remaining, 'monthly_estimate_usd': estimate, 'observed_at': observed,
            'fresh': 0 <= now - observed <= 3600, 'compute_scope_claimed': proof.get('compute_scope_verified') is True,
            'source': 'operator_record', 'independently_verified': False}

def create_worker(config_data, worker_id, now):
    name(worker_id)
    worker = config_data['workers'][worker_id]
    if worker.get('managed') is not True: raise ValueError('refusing to create an unmanaged worker')
    remote_path(worker['root'], 'workspaces', 'validation')
    ssh_args(worker)
    for key in ('project', 'zone', 'instance', 'pool'):
        if not isinstance(worker.get(key), str) or not NAME.fullmatch(worker[key]):
            raise ValueError('managed worker requires valid project, zone, instance and pool')
    spec = worker.get('create')
    if not isinstance(spec, dict): raise ValueError('worker creation requires an explicit instance specification')
    for key in ('machine_type', 'image_family', 'image_project'):
        if not isinstance(spec.get(key), str) or not NAME.fullmatch(spec[key]):
            raise ValueError('invalid worker creation specification')
    disk = spec.get('disk_gb')
    if isinstance(disk, bool) or not isinstance(disk, int) or not 20 <= disk <= 1000:
        raise ValueError('invalid worker boot disk size')
    limit = int(os.environ.get('GCPX_MAX_WORKERS', '3'))
    if limit < 1: raise ValueError('GCPX_MAX_WORKERS must be positive')
    check_credit(worker, now)
    listing = ['gcloud', 'compute', 'instances', 'list', '--project', worker['project'], '--filter',
               'labels.gcpx-managed=true AND labels.gcpx-pool=' + worker['pool'], '--format=json']
    pool = json.loads(run(listing, text=True, capture_output=True).stdout)
    if not isinstance(pool, list) or len(pool) >= limit: raise ValueError('managed worker pool is at its configured limit')
    if any(item.get('name') == worker['instance'] and item.get('zone', '').endswith('/' + worker['zone']) for item in pool):
        raise ValueError('worker instance already exists; inspect before retry')
    bootstrap = Path(__file__).resolve().parent / 'gcpx-worker-bootstrap'
    script = ROOT / ('bootstrap.' + uuid.uuid4().hex + '.sh')
    script.write_text('#!/bin/bash\nexport GCPX_WORKER_BOOTSTRAP=yes\n' + bootstrap.read_text())
    os.chmod(script, 0o600)
    try:
        cmd = ['gcloud', 'compute', 'instances', 'create', worker['instance'], '--project', worker['project'], '--zone', worker['zone'],
               '--machine-type', spec['machine_type'], '--image-family', spec['image_family'], '--image-project', spec['image_project'],
               '--boot-disk-size', str(disk) + 'GB', '--no-address', '--no-service-account', '--no-scopes',
               '--labels', 'gcpx-managed=true,gcpx-pool=' + worker['pool'], '--metadata-from-file', 'startup-script=' + str(script), '--quiet']
        run(cmd, stdout=sys.stderr)
    finally:
        script.unlink(missing_ok=True)
    describe = ['gcloud', 'compute', 'instances', 'describe', worker['instance'], '--project', worker['project'], '--zone', worker['zone'], '--format=json']
    instance = json.loads(run(describe, text=True, capture_output=True).stdout)
    labels = instance.get('labels') or {}
    if instance.get('name') != worker['instance'] or instance.get('status') != 'RUNNING' or labels.get('gcpx-managed') != 'true' or labels.get('gcpx-pool') != worker['pool']:
        raise ValueError('created worker state or ownership was not confirmed')
    ensure_worker_ready(worker)
    return {'worker': worker_id, 'status': 'RUNNING'}

def start_worker(config_data, worker_id, now):
    name(worker_id)
    worker = config_data['workers'][worker_id]
    if worker.get('managed') is not True:
        raise ValueError('refusing to start a worker not explicitly managed by gcpx')
    remote_path(worker['root'], 'workspaces', 'validation')
    ssh_args(worker)
    for key in ('project', 'zone', 'instance', 'pool'):
        if not isinstance(worker.get(key), str) or not NAME.fullmatch(worker[key]):
            raise ValueError('managed worker requires valid project, zone, instance and pool')
    identity = ['--project', worker['project'], '--zone', worker['zone']]
    describe = ['gcloud', 'compute', 'instances', 'describe', worker['instance'], *identity, '--format=json']
    instance = json.loads(run(describe, text=True, capture_output=True).stdout)
    labels = instance.get('labels') or {}
    if instance.get('name') != worker['instance'] or labels.get('gcpx-managed') != 'true' or labels.get('gcpx-pool') != worker['pool']:
        raise ValueError('worker ownership labels do not match; refusing start')
    if instance.get('status') == 'RUNNING':
        ensure_worker_ready(worker)
        return {'worker': worker_id, 'status': 'RUNNING'}
    if instance.get('status') != 'TERMINATED': raise ValueError('worker is not in a stable stopped state')
    check_credit(worker, now)
    run(['gcloud', 'compute', 'instances', 'start', worker['instance'], *identity, '--quiet'], stdout=sys.stderr)
    status = json.loads(run(describe, text=True, capture_output=True).stdout).get('status')
    if status != 'RUNNING': raise ValueError('worker start was not confirmed')
    ensure_worker_ready(worker)
    return {'worker': worker_id, 'status': status}

def reconcile_idle(config_data, state, now):
    idle = load_idle()
    result = {}
    for worker_id, worker in config_data['workers'].items():
        if worker.get('managed') is not True: continue
        name(worker_id)
        try:
            with ExitStack() as leases:
                for ws_id, item in state.items():
                    if item.get('worker') != worker_id: continue
                    if item.get('status') == 'creating': raise ValueError('workspace creation incomplete')
                    leases.enter_context(workspace_lease(ws_id, exclusive=True))
        except (ValueError, OSError):
            idle.pop(worker_id, None)
            result[worker_id] = 'busy or unknown'
            continue
        identity = [worker.get(key) for key in ('project', 'zone', 'instance', 'pool')]
        observation = idle.get(worker_id)
        if not isinstance(observation, dict) or observation.get('identity') != identity or not isinstance(observation.get('since'), (int, float)) or not 0 <= observation['since'] <= now:
            idle[worker_id] = {'identity': identity, 'since': now}
            result[worker_id] = 'observing idle'
        elif now - observation['since'] < 1800:
            result[worker_id] = 'observing idle'
        else:
            try:
                stop_worker(config_data, state, worker_id)
                idle.pop(worker_id, None)
                result[worker_id] = 'TERMINATED'
            except (ValueError, KeyError, OSError, subprocess.CalledProcessError):
                idle.pop(worker_id, None)
                result[worker_id] = 'stop unconfirmed'
    save_idle(idle)
    return result

SYNC_EXCLUDED = ('node_modules', '.gradle', 'build', 'dist')

def check_sync_coverage(worker, item, local):
    # Mutagen's exclusions are name-based, including nested paths. Never
    # silently omit local additions or remote source that Git would retain.
    local = Path(local)
    if local.exists():
        if not local.is_dir(): raise ValueError('synchronized directory is unavailable')
        def failed(error): raise error
        for _, directories, files in os.walk(local, onerror=failed, followlinks=False):
            if set(directories + files).intersection(SYNC_EXCLUDED):
                raise ValueError('local files match synchronization cache exclusions; inspect workspace before syncing')
            directories[:] = [directory for directory in directories if directory != '.git']
    patterns = [':(glob)**/' + directory + '/**' for directory in SYNC_EXCLUDED]
    visible = ssh(worker, cmdstr(['git', '-C', item['path'], 'ls-files', '--cached', '--others', '--exclude-standard', '-z', '--', *patterns]), capture=True).stdout
    if visible:
        raise ValueError('tracked or untracked source files match synchronization cache exclusions; inspect workspace before syncing')

def flush_sync(worker, item):
    sync = item['sync']
    check_sync_coverage(worker, item, sync['local'])
    mutagen(item['worker'], worker, 'sync', 'flush', sync['session'])

def remove_workspace(state, config_data, ws):
    item, worker = entry(state, config_data, ws)
    with workspace_lease(ws, exclusive=True):
        if item.get('sync'):
            flush_sync(worker, item)
        status = ssh(worker, cmdstr(['git','-C',item['path'],'status','--porcelain','--untracked-files=normal']), capture=True).stdout
        if status.strip(): raise ValueError('workspace has uncommitted or untracked files')
        head = ssh(worker, cmdstr(['git','-C',item['path'],'rev-parse','HEAD']), capture=True).stdout.strip()
        if head != item.get('base_head'):
            raise ValueError('workspace contains commits; retain it until their remote integration is verified')
        if item.get('sync'):
            mutagen(item['worker'], worker, 'sync', 'terminate', item['sync']['session'])
            del item['sync']; save_state(state)
        ssh(worker, cmdstr(['git','-C',item['mirror'],'worktree','remove',item['path']]))
        del state[ws]; save_state(state)

def output(value, as_json):
    if as_json: print(json.dumps(value, ensure_ascii=False))
    elif isinstance(value, (dict, list)): print(json.dumps(value, ensure_ascii=False, indent=2))
    else: print(value)

def main():
    parser = argparse.ArgumentParser(prog='gcpx')
    parser.add_argument('--config', default=os.environ.get('GCPX_CONFIG', '.gcpx.json'))
    parser.add_argument('--json', action='store_true')
    sub = parser.add_subparsers(dest='action', required=True)
    sub.add_parser('status')
    for action in ('up', 'down'):
        p = sub.add_parser(action); p.add_argument('worker')
    p = sub.add_parser('ws'); ws = p.add_subparsers(dest='ws_action', required=True)
    p = ws.add_parser('new'); p.add_argument('repo'); p.add_argument('--worker'); p.add_argument('--name'); ref = p.add_mutually_exclusive_group(); ref.add_argument('--sha'); ref.add_argument('--branch')
    ws.add_parser('ls')
    p = ws.add_parser('rm'); p.add_argument('workspace')
    p = sub.add_parser('run'); p.add_argument('workspace'); p.add_argument('command', nargs=argparse.REMAINDER)
    p = sub.add_parser('shell'); p.add_argument('workspace')
    p = sub.add_parser('mount'); p.add_argument('workspace'); p.add_argument('local')
    p = sub.add_parser('_transport', help=argparse.SUPPRESS); p.add_argument('workspace'); p.add_argument('--control-port', type=int)
    p = sub.add_parser('sync'); p.add_argument('workspace'); p.add_argument('local'); p.add_argument('--flush', action='store_true')
    p = sub.add_parser('cp'); p.add_argument('workspace'); p.add_argument('remote'); p.add_argument('local')
    sub.add_parser('logs')
    sub.add_parser('reconcile')
    p = sub.add_parser('gc'); p.add_argument('--older-than-hours', type=float, default=168)
    args = parser.parse_args()
    cfg = config(args.config)
    ROOT.mkdir(parents=True, mode=0o700, exist_ok=True)
    with (ROOT / 'lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = load_state()
        if args.action == 'ws' and args.ws_action == 'ls': output(state, args.json); return
        if args.action == 'status':
            workers = {}
            for key, worker in cfg['workers'].items():
                try:
                    load = ssh(worker, 'cat /proc/loadavg', capture=True).stdout.strip()
                    workers[key] = {'reachable': True, 'load': load}
                except (OSError, subprocess.CalledProcessError): workers[key] = {'reachable': False, 'load': None}
            output({'workers': workers, 'workspaces': state, 'credit_balance': credit_summary(cfg, time.time())}, args.json); return
        if args.action == 'up':
            result = start_worker(cfg, args.worker, time.time())
            mark_worker_busy(args.worker)
            log_event('up', worker=args.worker, status=result['status'])
            output(result, args.json); return
        if args.action == 'down':
            result = stop_worker(cfg, state, args.worker)
            mark_worker_busy(args.worker)
            log_event('down', worker=args.worker, status=result['status'])
            output(result, args.json); return
        if args.action == 'reconcile':
            result = reconcile_idle(cfg, state, time.time())
            for worker_id, status in result.items():
                if status in ('TERMINATED', 'stop unconfirmed'): log_event('reconcile', worker=worker_id, status=status)
            output(result, args.json); return
        if args.action == 'logs':
            p = ROOT / 'events.log'
            lines = p.read_text().splitlines() if p.exists() else []
            if args.json: output([json.loads(line) for line in lines], True)
            else: print('\n'.join(lines) + ('\n' if lines else ''), end='')
            return
        if args.action == 'gc':
            if args.older_than_hours <= 0: raise ValueError('invalid age')
            candidates = [k for k,v in state.items() if time.time() - v.get('last_used', v['created']) > args.older_than_hours * 3600]
            removed, retained = [], {}
            for ws_id in candidates:
                try:
                    mark_worker_busy(state[ws_id]['worker'])
                    remove_workspace(state, cfg, ws_id); removed.append(ws_id)
                    log_event('gc', workspace=ws_id)
                except (ValueError, KeyError, OSError, subprocess.CalledProcessError) as error:
                    retained[ws_id] = str(error)
            output({'candidates': candidates, 'removed': removed, 'retained': retained}, args.json); return
        if args.action == 'ws' and args.ws_action == 'new':
            repo = name(args.repo); spec = cfg['repos'][repo]
            ws_id = name(args.name or (repo + '-' + uuid.uuid4().hex[:12]))
            if ws_id in state: raise ValueError('workspace already exists')
            ref = args.sha or args.branch or spec.get('branch', 'main')
            if args.sha and not re.fullmatch(r'[0-9a-fA-F]{40}', args.sha): raise ValueError('sha must be full commit hash')
            if not re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9_./-]{0,199}', ref) or '..' in ref: raise ValueError('invalid ref')
            url = spec['url']
            if not isinstance(url, str) or not re.match(r'^(https://|ssh://|git@)', url) or any(c.isspace() for c in url): raise ValueError('invalid repository URL')
            if url.startswith(('https://', 'ssh://')) and (urlsplit(url).password or (url.startswith('https://') and urlsplit(url).username)):
                raise ValueError('repository URL must not contain credentials')
            worker_id, worker = allocate_worker(cfg, state, repo, args.worker)
            mark_worker_busy(worker_id)
            mirror = remote_path(worker['root'], 'repos', repo + '.git')
            target = remote_path(worker['root'], 'workspaces', ws_id)
            branchref = ref if args.sha else 'refs/heads/' + ref
            # The remote flock serializes clone/fetch/worktree changes for a repository.
            script = 'set -eu; mkdir -p -- "$1/repos" "$1/workspaces"; flock "$1/repos/$2.lock" sh -c '\
                + shlex.quote('set -eu; if [ ! -d "$1" ]; then git clone --mirror -- "$3" "$1"; fi; git -C "$1" fetch --prune origin; git -C "$1" worktree add --detach "$2" "$4" >&2; git -C "$2" rev-parse HEAD') \
                + ' sh "$3" "$4" "$5" "$6"'
            now = time.time()
            state[ws_id] = {'repo': repo, 'worker': worker_id, 'path': target, 'mirror': mirror, 'status': 'creating', 'created': now, 'last_used': now,
                            'base_ref': ref, 'base_ref_kind': 'sha' if args.sha else 'branch'}
            save_state(state)
            with workspace_lease(ws_id, exclusive=True):
                fcntl.flock(lock, fcntl.LOCK_UN)
                result = ssh(worker, cmdstr(['sh','-c',script,'sh',worker['root'],repo,mirror,target,url,branchref]), capture=True)
                if result.stderr: print(result.stderr, file=sys.stderr, end='')
                base_head = result.stdout.strip()
                if not re.fullmatch(r'[0-9a-f]{40}', base_head): raise ValueError('remote worktree returned invalid HEAD; inspect remote directory before retry')
                fcntl.flock(lock, fcntl.LOCK_EX)
                state = load_state()
                state[ws_id].pop('status')
                state[ws_id]['base_head'] = base_head
                save_state(state); log_event('ws.new', workspace=ws_id, worker=worker_id)
                output({'id': ws_id, **state[ws_id]}, args.json); return
        if args.action == 'ws' and args.ws_action == 'rm':
            mark_worker_busy(entry(state, cfg, args.workspace)[0]['worker'])
            remove_workspace(state, cfg, args.workspace)
            log_event('ws.rm', workspace=args.workspace)
            output({'removed': args.workspace}, args.json); return
        item, worker = entry(state, cfg, args.workspace)
        mark_worker_busy(item['worker'])
        item['last_used'] = time.time(); save_state(state)
        if args.action == '_transport':
            with workspace_lease(args.workspace):
                fcntl.flock(lock, fcntl.LOCK_UN)
                sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'src'))
                from gcpx_transport import serve
                control = None
                if args.control_port is not None:
                    control = {**json.loads(sys.stdin.readline()), 'port': args.control_port}
                serve(worker, args.workspace, ROOT, control=control)
            return
        if args.action == 'run':
            command = args.command[1:] if args.command[:1] == ['--'] else args.command
            if not command: raise ValueError('missing command')
            with workspace_lease(args.workspace):
                if item.get('sync'):
                    flush_sync(worker, item)
                # Do not hold the registry lock during a potentially long-running command.
                fcntl.flock(lock, fcntl.LOCK_UN)
                result = subprocess.run([*ssh_args(worker), 'cd -- ' + shlex.quote(item['path']) + ' && exec ' + cmdstr(command)])
                if item.get('sync'):
                    flush_sync(worker, item)
                log_event('run', workspace=args.workspace, worker=item['worker'], exit_code=result.returncode)
                return result.returncode
        if args.action == 'shell':
            lease = workspace_lease(args.workspace)
            os.set_inheritable(lease.fileno(), True)
            fcntl.flock(lock, fcntl.LOCK_UN)
            os.execv('/usr/bin/ssh', [*ssh_args(worker)[:-1], '-t', ssh_args(worker)[-1], 'cd -- ' + shlex.quote(item['path']) + ' && exec "${SHELL:-/bin/sh}" -l'])
        if args.action == 'mount':
            Path(args.local).mkdir(parents=True, exist_ok=True)
            # Replace this process so the lease lives exactly as long as sshfs.
            lease = workspace_lease(args.workspace)
            os.set_inheritable(lease.fileno(), True)
            fcntl.flock(lock, fcntl.LOCK_UN)
            os.execvp('sshfs', ['sshfs', '-f', '-F', str(Path(worker['ssh_config']).expanduser()), worker['host'] + ':' + item['path'], args.local])
        if args.action == 'sync':
            local = Path(args.local).expanduser().resolve()
            sync = item.get('sync')
            if sync:
                if str(local) != sync['local']: raise ValueError('workspace already has a different synchronized directory')
            else:
                if args.flush: raise ValueError('workspace has no synchronization session')
                if local.exists() and (not local.is_dir() or any(local.iterdir())):
                    raise ValueError('new synchronization directory must be empty')
                check_sync_coverage(worker, item, local)
                local.mkdir(parents=True, mode=0o700, exist_ok=True)
                session = 'gcpx-' + uuid.uuid4().hex
                ssh(worker, 'true', capture=True)  # Establish ControlMaster before Mutagen opens concurrent channels.
                mutagen(item['worker'], worker, 'sync', 'create', '--no-global-configuration', '--name', session,
                        '--mode', 'two-way-safe', '--ignore-vcs', '--ignore', '.git', '--ignore', 'node_modules', '--ignore', '.gradle',
                        '--ignore', 'build', '--ignore', 'dist', str(local), worker['host'] + ':' + item['path'])
                item['sync'] = sync = {'session': session, 'local': str(local)}
                save_state(state)
            flush_sync(worker, item)
            output({'workspace': args.workspace, 'local': str(local), 'session': sync['session']}, args.json); return
        if args.action == 'cp':
            path = PurePosixPath(args.remote)
            if path.is_absolute() or '..' in path.parts: raise ValueError('remote path must be inside workspace')
            run(['/usr/bin/scp','-F',str(Path(worker['ssh_config']).expanduser()),worker['host'] + ':' + item['path'] + '/' + str(path),args.local]); return

if __name__ == '__main__':
    try: sys.exit(main())
    except (ValueError, KeyError, OSError, subprocess.CalledProcessError) as exc:
        print('gcpx: ' + str(exc), file=sys.stderr); sys.exit(exc.returncode if isinstance(exc, subprocess.CalledProcessError) and exc.returncode > 0 else 1)
