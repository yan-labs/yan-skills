#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
  target=$(readlink "$script")
  case "$target" in
    /*) script=$target ;;
    *) script=$(dirname "$script")/$target ;;
  esac
done
dir=$(CDPATH= cd -P "$(dirname "$script")" && pwd -P)
case "${1:-}" in
  heavy)
    shift
    exec python3 "$dir/../src/host-lock.py" heavy "$@"
    ;;
  status)
    shift
    exec python3 "$dir/../src/status-cache.py" "$@"
    ;;
  watch)
    shift
    if [ "${1:-}" = --dispatch ]; then exec python3 "$dir/fleet-watch.py" "$@"; fi
    if [ "${1:-}" = hook ]; then exec python3 "$dir/../hooks/fleet-seat.py"; fi
    if [ "${1:-}" = patrol ]; then shift; exec python3 "$dir/fleet-watch.py" --patrol "$@"; fi
    exec python3 "$dir/../src/watch-store.py" "$@"
    ;;
  wait|say|stop|tail)
    if [ -n "${2:-}" ]; then
      if python3 "$dir/../src/mini.py" has "$2"; then
        exec python3 "$dir/../src/mini.py" "$@"
      else
        rc=$?
        [ "$rc" -eq 2 ] || exit "$rc"
        local_id=$(python3 "$dir/../src/mini.py" local-id "$2") || rc=$?
        if [ -n "$local_id" ]; then
          command=$1; shift 2
          exec node "$dir/agent-fleet.mjs" "$command" "$local_id" "$@"
        fi
      fi
    fi
    ;;
esac
if [ "${1:-}" = web ]; then
  shift
  exec node "$dir/chatgpt-web-ask.mjs" "$@"
fi
exec node "$dir/agent-fleet.mjs" "$@"
