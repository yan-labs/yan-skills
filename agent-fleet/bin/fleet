#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
  target=$(readlink "$script")
  case "$target" in
    /*) script=$target ;;
    *) script=$(dirname "$script")/$target ;;
  esac
done
dir=$(CDPATH= cd -P "$(dirname "$script")" && pwd -P)
case "${1:-}" in
  wait|say|stop|tail)
    if [ -n "${2:-}" ]; then
      if python3 "$dir/../src/mini.py" has "$2"; then
        exec python3 "$dir/../src/mini.py" "$@"
      else
        rc=$?
        [ "$rc" -eq 2 ] || exit "$rc"
      fi
    fi
    ;;
esac
if [ "${1:-}" = web ]; then
  shift
  exec node "$dir/chatgpt-web-ask.mjs" "$@"
fi
exec node "$dir/agent-fleet.mjs" "$@"
