#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
  target=$(readlink "$script")
  case "$target" in
    /*) script=$target ;;
    *) script=$(dirname "$script")/$target ;;
  esac
done
dir=$(CDPATH= cd -P "$(dirname "$script")"; pwd -P)
export PATH="$dir:$PATH"
exec python3 "$dir/../src/fleet-go.py" "$@"
